OPENROUTER_API_KEY=sk-or-v1-replace_with_your_openrouter_key
OPENROUTER_MODEL=openrouter/free
# ===========================================
# BOSSNU.SILEO Agent — Environment Variables
# ===========================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ห้าม commit token จริงขึ้น Git

# GitHub Personal Access Token (จำเป็นสำหรับ MCP)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_replace_with_your_github_pat

# Puter Auth Token (สำหรับเรียก LLM)
# สร้างได้ที่ https://puter.com/dashboard#account → Create token
PUTER_AUTH_TOKEN=replace_with_your_puter_auth_token

# (Optional)
# NEXT_PUBLIC_WORKSPACE_URL=https://panuss09-br0npxbrw-mvp-5685.vercel.app/
